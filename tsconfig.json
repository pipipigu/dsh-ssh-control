{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@deepseek-harness-tui/dsh-tui/*": ["./src/types/dsh-tui.d.ts"],
      "@deepseek-harness-tui/dsh-tui": ["./src/types/dsh-tui.d.ts"]
    }
  },
  "include": ["src", "tests", "tsdown.config.ts"],
  "exclude": ["src/client"]
}
